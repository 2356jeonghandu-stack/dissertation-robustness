data/processed/*
!data/processed/.gitkeep

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# macOS
.DS_Store

# Python virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.*

